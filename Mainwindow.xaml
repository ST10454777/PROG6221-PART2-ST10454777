<Window x:Class="CybersecurityChatbotGUI.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="Cybersecurity Awareness Chatbot" Height="700" Width="950"
WindowStartupLocation="CenterScreen" Background="#0F172A">
<Grid Margin="15">
<Grid.RowDefinitions>
<RowDefinition Height="Auto"/>
<RowDefinition Height="*"/>
<RowDefinition Height="Auto"/>
</Grid.RowDefinitions>

<!-- Header with ASCII ART -->
<Border Grid.Row="0" Background="#1E293B" CornerRadius="12" Padding="15" Margin="0,0,0,10">
<StackPanel>
<TextBlock Text="CYBER-GUARD CHATBOT" Foreground="#38BDF8" FontSize="24" FontWeight="Bold"/>
<TextBlock x:Name="AsciiArtBlock" Foreground="#22C55E" FontFamily="Consolas" FontSize="10" TextAlignment="Center"
Text=".-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-"/>
<TextBlock x:Name="MemoryLabel" Foreground="#FACC15" FontSize="12" Margin="0,5,0,0" Text="Memory: No user info yet"/>
</StackPanel>
</Border>

<!-- Chat Area -->
<Border Grid.Row="1" Background="White" CornerRadius="12" Padding="10">
<ScrollViewer x:Name="ChatScroll">
<StackPanel x:Name="ChatPanel"/>
</ScrollViewer>
</Border>

<!-- Input Area -->
<Grid Grid.Row="2" Margin="0,10,0,0">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="*"/>
<ColumnDefinition Width="Auto"/>
</Grid.ColumnDefinitions>
<TextBox x:Name="UserInputBox" Grid.Column="0" Height="45" FontSize="14" Padding="10"
BorderBrush="#38BDF8" BorderThickness="2" KeyDown="UserInputBox_KeyDown"/>
<Button Grid.Column="1" Content="SEND" Width="100" Height="45" Margin="10,0,0,0" Background="#38BDF8" Foreground="White" FontWeight="Bold" Click="SendButton_Click"/>
</Grid>
</Grid>
</Window>
